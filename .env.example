# Base URL of the panel (serves GET /api/public/site). Needed at build time and runtime.
ADMIN_API_URL="https://webdev.recife.br/paineldosite"
# Same value as REVALIDATE_SECRET in the panel (openssl rand -base64 32)
REVALIDATE_SECRET=""
# Same value as SITE_FORM_SECRET in the panel (quote form submissions)
SITE_FORM_SECRET=""
